+    public void setSurfaceListener(SurfaceListener listener) {
+        mSurfaceListener = listener;
+        if (mPreviewSurface != null && listener != null) {
+            listener.onSurfaceReady(mPreviewSurface);
+        }
+    }
+
+    private void updatePreviewSurface() {
+        if (mTextureView == null || !mTextureView.isAvailable()) {
+            return;
+        }
+        final SurfaceTexture texture = mTextureView.getSurfaceTexture();
+        if (texture == null) {
+            return;
+        }
+        if (mPreviewSurface != null) {
+            mPreviewSurface.release();
+        }
+        mPreviewSurface = new Surface(texture);
+        if (mSurfaceListener != null) {
+            mSurfaceListener.onSurfaceReady(mPreviewSurface);
+        }
+    }
+
+    private void releasePreviewSurface() {
+        if (mPreviewSurface != null) {
+            mPreviewSurface.release();
+            mPreviewSurface = null;
+        }
+    }
