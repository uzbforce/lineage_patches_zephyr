Subject: [vendor/qcom/opensource/dataservices] import the kernel headers namespace

diff --git a/Android.bp b/Android.bp
index 9515b25..f713cc6 100644
--- a/Android.bp
+++ b/Android.bp
@@ -1,2 +1,8 @@
 soong_namespace {
+    imports: [
