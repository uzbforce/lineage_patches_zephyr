diff --git a/build/tasks/build-manifest_xml.mk b/build/tasks/build-manifest_xml.mk
index 5f54967..10ecdd6 100644
--- a/build/tasks/build-manifest_xml.mk
+++ b/build/tasks/build-manifest_xml.mk
@@ -18,7 +18,14 @@ endif
 
 $(INSTALLED_BUILD_MANIFEST_XML_TARGET):
 	mkdir -p $(dir $@)
-	REPO_TRACE=0 python3 .repo/repo/repo manifest -o - -r | grep -Ev "proprietary_$(MANIFEST_EXCLUDES)" > $@
+# `repo manifest -r` needs every manifest project to be checked out; this tree
+# intentionally omits a few (the device builds the sm6225 CAF HALs instead of
+# hardware/qcom/audio). Fall back to the unpinned manifest, which still lists
+# every project, instead of failing the OTA over a metadata file.
+	REPO_TRACE=0 python3 .repo/repo/repo manifest -o $@.raw -r 2>/dev/null || \
+	REPO_TRACE=0 python3 .repo/repo/repo manifest -o $@.raw 2>/dev/null
+	grep -Ev "proprietary_$(MANIFEST_EXCLUDES)" $@.raw > $@
+	@rm -f $@.raw
 
 .PHONY: build-manifest.xml
 build-manifest.xml: $(INSTALLED_BUILD_MANIFEST_XML_TARGET)
