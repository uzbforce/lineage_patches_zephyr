diff --git a/private/recovery.te b/private/recovery.te
index e0cc5ca43..4656bf789 100644
--- a/private/recovery.te
+++ b/private/recovery.te
@@ -116,6 +116,11 @@ recovery_only(`
   # Read /sysfs/fs/ext4/features
   r_dir_file(recovery, sysfs_fs_ext4_features)
 
+  # fs_mgr reads /sys/fs/f2fs/features/linear_lookup before running fsck.f2fs.
+  # Without this the recovery log prints a permission-denied error during OTA
+  # installation (the update still applies, but the log is noisy).
+  r_dir_file(recovery, sysfs_fs_f2fs)
+
   # Read from /sys/class/leds/lcd-backlight/max_brightness and write to /s/c/l/l/brightness to
   # control backlight brightness.
   allow recovery sysfs_leds:dir r_dir_perms;
diff --git a/private/system_suspend.te b/private/system_suspend.te
index a52586660..44c818e59 100644
--- a/private/system_suspend.te
+++ b/private/system_suspend.te
@@ -19,6 +19,12 @@ r_dir_file(system_suspend, sysfs_wakeup_reasons)
 # To resolve arbitrary sysfs paths from /sys/class/wakeup/* symlinks.
 allow system_suspend sysfs_type:dir search;
 
+# On zephyr some /sys/class/wakeup/* symlinks resolve into charger
+# power-supply wakeupN directories that are not covered by sysfs_wakeup.
+# SystemSuspend only reads the counters (name, active_count, *_time_ms);
+# allow that read-only fallback without granting write access.
+allow system_suspend sysfs:file r_file_perms;
+
 # Access to suspend_hal system properties
 get_prop(system_suspend, suspend_prop)
 
diff --git a/private/vibrator_init.te b/private/vibrator_init.te
new file mode 100644
index 000000000..94f06235b
--- /dev/null
+++ b/private/vibrator_init.te
@@ -0,0 +1,11 @@
+#
+# SPDX-FileCopyrightText: The LineageOS Project
+# SPDX-License-Identifier: Apache-2.0
+#
+
+# init reaches /sys/class/leds/vibrator through generic /sys and /sys/class
+# directories before entering the sysfs_leds directory. The device
+# system_ext policy grants sysfs_leds traversal and file access; this grants
+# the generic sysfs parents and the LED symlink itself.
+allow init sysfs:dir r_dir_perms;
+allow init sysfs:lnk_file r_file_perms;
