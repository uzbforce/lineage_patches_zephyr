diff --git a/Android.bp b/Android.bp
index 7c667c8d5..c8035be08 100644
--- a/Android.bp
+++ b/Android.bp
@@ -704,6 +704,16 @@ precompiled_se_policy_binary {
     srcs: [
         ":precompiled_sepolicy_srcs",
     ],
+    // Closed-source Xiaomi blobs (FOD display/touch feature HALs and
+    // mi_thermald) poke undocumented sysfs/ioctl surfaces; their domains are
+    // deliberately permissive. Allowlist them for non-debuggable builds so a
+    // user build does not fail the permissive-domain check.
+    permissive_domains_on_user_builds: [
+        "displayfeature",
+        "hal_displayfeature_xiaomi_default",
+        "hal_touchfeature_xiaomi_default",
+        "mi_thermald",
+    ],
     soong_config_variables: {
         BOARD_USES_ODMIMAGE: {
             device_specific: true,
@@ -749,6 +759,12 @@ se_policy_binary {
     srcs: [":recovery_sepolicy.cil"],
     stem: "sepolicy",
     recovery: true,
+    permissive_domains_on_user_builds: [
+        "displayfeature",
+        "hal_displayfeature_xiaomi_default",
+        "hal_touchfeature_xiaomi_default",
+        "mi_thermald",
+    ],
 }
 
