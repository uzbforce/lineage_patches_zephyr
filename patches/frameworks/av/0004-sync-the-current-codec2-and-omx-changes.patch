+    //   W CCodec: [c2.qti.avc.encoder] previous call to createInputSurface
+    //             exceeded timeout
+    //   -> onError(UNKNOWN_ERROR, ACTION_CODE_FATAL)
+    //   screenrecord: ERROR: unable to create encoder input surface (err=-2147483648)
+    //
+    // Decoding to a Surface still worked because that path allocates its output
+    // buffers through the buffer channel and never calls this.
+    //
+    // debug.stagefright.c2inputsurface=-1 already selects a locally created
+    // AidlGraphicBufferSource, but stock only tests it *after* the hanging store
+    // call, so it could never take effect here. Test it first: with the switch
+    // set, the surface is built in-process and Codec2Client::CreateInputSurface()
+    // is never entered. Set it to -1 in the device props.
     if (property_get_int32("debug.stagefright.c2inputsurface", 0) == -1) {
-        sp<IGraphicBufferProducer> gbp;
         sp<AidlGraphicBufferSource> gbs = new AidlGraphicBufferSource();
         status_t err = gbs->initCheck();
         if (err != OK) {
@@ -3432,9 +3445,19 @@ PersistentSurface *CCodec::CreateInputSurface() {
               PersistentSurface::TYPE_AIDLSOURCE,
               mediaflagtools::igbpToSurfaceType(gbs->getIGraphicBufferProducer()),
               wrapper->asBinder());
-    } else {
-        return nullptr;
     }
+
+    std::shared_ptr<Codec2Client::InputSurface> inputSurface =
+            Codec2Client::CreateInputSurface();
+    if (inputSurface) {
+        ::ndk::SpAIBinder interface = inputSurface->getHalInterface();
+        ANativeWindow *window = inputSurface->getNativeWindow();
+        return new PersistentSurface(PersistentSurface::TYPE_INPUTSURFACE,
+                mediaflagtools::nativeWindowToSurfaceType(window),
+                interface);
+    }
+
+    return nullptr;
 }
 
