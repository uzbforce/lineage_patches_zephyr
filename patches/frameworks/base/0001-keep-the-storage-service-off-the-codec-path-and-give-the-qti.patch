From: uzbforce <oktamovazizbek2010@gmail.com>
Subject: [frameworks/base] keep the storage service off the codec path and unblock keyguard-occluded input

diff --git a/packages/SystemUI/src/com/android/systemui/shade/NotificationShadeWindowControllerImpl.java b/packages/SystemUI/src/com/android/systemui/shade/NotificationShadeWindowControllerImpl.java
index 25f87803e40a..a8fd75682909 100644
--- a/packages/SystemUI/src/com/android/systemui/shade/NotificationShadeWindowControllerImpl.java
+++ b/packages/SystemUI/src/com/android/systemui/shade/NotificationShadeWindowControllerImpl.java
@@ -360,6 +360,23 @@ public class NotificationShadeWindowControllerImpl
         if (mKeyguardViewMediator.isShowingAndNotOccluded()) {
             setKeyguardShowing(true);
         }
+
+        if (!SceneContainerFlag.isEnabled()) {
+            // The notification shade window's occlusion state is normally updated from
+            // NotificationShadeWindowModel, which derives it from the keyguard transition
+            // state machine. That machine is not driven while the WM state refactor is
+            // disabled, so the window kept the keyguard-showing flags and stayed focusable
+            // on top of SHOW_WHEN_LOCKED activities (e.g. the secure camera launched from
+            // the lock screen), swallowing all touch and key input. Mirror the legacy
+            // KeyguardStateController here, as CentralSurfaces does for the scrim.
+            mKeyguardStateController.addCallback(
+                    new KeyguardStateController.Callback() {
+                        @Override
+                        public void onKeyguardShowingChanged() {
+                            setKeyguardOccluded(mKeyguardStateController.isOccluded());
+                        }
+                    });
+        }
     }
 
     @Nullable
diff --git a/services/core/java/com/android/server/StorageManagerService.java b/services/core/java/com/android/server/StorageManagerService.java
index c7d9893a3fb0..4c2de708621d 100644
--- a/services/core/java/com/android/server/StorageManagerService.java
+++ b/services/core/java/com/android/server/StorageManagerService.java
@@ -997,7 +997,14 @@ class StorageManagerService extends IStorageManager.Stub
             }
         }
 
-        configureTranscoding();
+        // Codec enumeration reaches IMediaPlayerService#getCodecList(). On this port
+        // the vendor Codec2 HAL does not start, and that binder call never returns,
+        // so running it here would wedge this handler thread. Every message queued
+        // behind it -- H_BOOT_COMPLETED, H_COMPLETE_UNLOCK_USER, H_VOLUME_MOUNT --
+        // would then go unprocessed and /storage/emulated would stay unmounted for
+        // the whole boot. Keep it off this thread so a stuck codec service can only
+        // affect transcoding.
+        new Thread(this::configureTranscoding, "StorageTranscodeConfig").start();
 
         // Guard the new feature call with the aflag
         if (Flags.enableFilesystemConfigurationV2()) {
@@ -2295,6 +2302,21 @@ class StorageManagerService extends IStorageManager.Stub
 
     private void handleBootCompleted() {
         resetIfBootedAndConnected();
+
+        // The first emulated-volume mount can race MediaProvider startup on some
+        // devices and leave /storage/emulated/0 unmounted for the whole boot.
+        // Retry once the system has settled; a second mount of an already
+        // mounted volume is a no-op in vold.
+        mHandler.postDelayed(() -> {
+            for (int i = 0; i < mVolumes.size(); i++) {
+                final WatchedVolumeInfo vol = mVolumes.valueAt(i);
+                if (vol.getType() == VolumeInfo.TYPE_EMULATED
+                        && vol.getState() == VolumeInfo.STATE_UNMOUNTED) {
+                    Slog.i(TAG, "Retrying mount of " + vol.getId() + " after boot");
+                    mHandler.obtainMessage(H_VOLUME_MOUNT, vol).sendToTarget();
+                }
+            }
+        }, 15000);
     }
 
     private String getDefaultPrimaryStorageUuid() {
