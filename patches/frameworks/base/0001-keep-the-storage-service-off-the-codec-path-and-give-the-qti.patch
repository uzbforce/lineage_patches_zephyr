+package android.telephony;
+
+/**
+ * Stub for the MIUI framework class of the same name.
+ *
+ * <p>The stock {@code org.codeaurora.ims} and {@code QtiTelephony} blobs link
+ * against {@code android.telephony.TelephonyBaseUtilsStub} to ask whether they
+ * are running on MIUI, and pick MIUI-specific telephony code paths when they
+ * are. AOSP/LineageOS has no such class, so the linker fails with
+ * {@code ClassNotFoundException} while the IMS service is being created and the
+ * service crash-loops before it can ever register with
+ * {@code com.android.internal.telephony.ims.ImsResolver}.
+ *
+ * <p>Only {@link #isMiuiRom()} is called by those blobs, and this build is not
+ * MIUI, so it always reports {@code false}.
+ *
+ * @hide
+ */
+public final class TelephonyBaseUtilsStub {
+    private TelephonyBaseUtilsStub() {
+    }
+
+    /**
+     * @return whether this build is MIUI.
+     */
+    public static boolean isMiuiRom() {
+        return false;
+    }
+}
